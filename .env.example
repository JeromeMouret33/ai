# Copier en .env et renseigner. Ne jamais committer le .env réel.

# OpenRouter (1 seule clé, API compatible OpenAI) — classification, génération, QC.
OPENROUTER_API_KEY=

# Supabase (Phase 2).
SUPABASE_URL=
SUPABASE_KEY=

# Authentification (Supabase Auth — Google OAuth, invite-only).
# Secret JWT du projet (Settings → API → JWT Secret). Si vide : auth DÉSACTIVÉE (dev).
SUPABASE_JWT_SECRET=
# Optionnel : liste blanche d'emails autorisés (défense en profondeur), séparés par des virgules.
AUTH_ALLOWED_EMAILS=

# Google Drive (Phase 2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
