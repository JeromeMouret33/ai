# Copier en .env et renseigner. Ne jamais committer le .env réel.

# OpenRouter (1 seule clé, API compatible OpenAI) — classification, génération, QC.
OPENROUTER_API_KEY=

# Supabase (Phase 2).
SUPABASE_URL=
SUPABASE_KEY=

# Authentification (Supabase Auth — Google + Apple, invite-only).
# La vérification des tokens se fait via JWKS à partir de SUPABASE_URL (nouvelles
# « JWT Signing Keys » ES256). SUPABASE_JWT_SECRET n'est utile QUE si le projet
# émet encore des tokens HS256 (legacy) — sinon laisser vide.
SUPABASE_JWT_SECRET=
# Optionnel : liste blanche d'emails autorisés (défense en profondeur), séparés par des virgules.
AUTH_ALLOWED_EMAILS=

# CORS prod : URLs autorisées (ex. https://ton-front.vercel.app), séparées par des virgules.
# "*" en dev. À restreindre en production.
ALLOWED_ORIGINS=*

# Mettre "production" en prod : refuse de démarrer ouvert si SUPABASE_JWT_SECRET manque.
ENVIRONMENT=
# Taille max par fichier uploadé (octets). Défaut 25 Mo.
MAX_UPLOAD_BYTES=
# Phase 4 — robustesse
JOBS_PER_MINUTE=10        # rate limit création de job / retry par utilisateur
SIGNED_URL_TTL=604800     # durée (s) des URLs signées des candidats (défaut 7 j)
LOG_LEVEL=INFO

# --- Frontend (Vercel) ---
# NEXT_PUBLIC_API_BASE=https://ton-backend.up.railway.app
# NEXT_PUBLIC_SUPABASE_URL=        # = SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # clé anon publique (Settings → API)

# Google Drive (Phase 2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
