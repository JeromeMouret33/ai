# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── External chat service ───────────────────────────────────────────────────
# Base URL of your chat API, WITHOUT trailing slash.
# Example: https://api.mychat.com/v1
CHAT_API_BASE_URL=https://api.example.com/v1

# Authentication key for your chat API.
# Used as: Authorization: Bearer <key>
# Swap to "X-API-Key" header in src/lib/chat-api.ts if your API requires it.
CHAT_API_KEY=your-chat-api-key-here

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Get yours at https://platform.openai.com/api-keys
# Used server-side only – never exposed to the browser.
OPENAI_API_KEY=sk-...
